NODE_ENV=development
PORT=5000
=
DATABASE_URL="postgres://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"
=
# Optional, migrations only. Set this ONLY if DATABASE_URL carries
# `channel_binding=require` (Neon does by default): Prisma's migration engine
# cannot negotiate it and reports `P1001: Can't reach database server` even
# though the app itself connects fine. Copy DATABASE_URL here and drop the
# `channel_binding` parameter, keeping `sslmode=require`. Leave unset
# otherwise — prisma.config.ts falls back to DATABASE_URL.
DIRECT_DATABASE_URL="postgres://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"
=
BETTER_AUTH_SECRET=your-better-auth-secret
=
BETTER_AUTH_URL=http://localhost:5000
=
ACCESS_TOKEN_SECRET=your-access-token-secret
REFRESH_TOKEN_SECRET=your-refresh-token-secret
ACCESS_TOKEN_EXPIRES_IN=1d
REFRESH_TOKEN_EXPIRES_IN=7d
=
# email Configuration
EMAIL_SENDER_SMTP_USER=your-smtp-user@example.com
EMAIL_SENDER_SMTP_PASS=your-smtp-app-password
EMAIL_SENDER_SMTP_HOST=smtp.gmail.com
EMAIL_SENDER_SMTP_PORT=465
EMAIL_SENDER_SMTP_FROM=your-from-address@example.com
=
=
# Google OAuth Configuration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=
=
=
FRONTEND_URL=http://localhost:3000
=
# Origin of the deployed admin panel. Optional locally (the allowlist already
# carries the localhost dev ports), REQUIRED once the panel is deployed.
#
# A third origin, distinct from FRONTEND_URL (the storefront) and
# BETTER_AUTH_URL (this server). Without it, every admin request fails CORS
# preflight — which looks like "the panel loads but nothing works" rather than
# like a configuration problem. It feeds both the CORS allowlist in app.ts and
# better-auth's trustedOrigins in lib/auth.ts.
#
# Origin only — no trailing slash, no path.
ADMIN_URL=
=
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUBSCRIPTION_BKASH_NUMBER=
# Storefront cache revalidation (optional). Must match REVALIDATE_SECRET in
# frontend/.env.local. STOREFRONT_URL defaults to FRONTEND_URL when unset.
STOREFRONT_REVALIDATE_SECRET=
STOREFRONT_URL=http://localhost:4000
=
# Steadfast Courier (optional). Without these the courier endpoints report
# themselves unconfigured and manual shipment entry is unaffected.
#
# These are env vars and NOT store settings on purpose: GET /settings is a
# public endpoint, so a credential kept on that row could be served to the
# internet by one careless field selection. Rotating a key is therefore a
# redeploy, not a form.
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=
# Optional — the live API (https://portal.packzy.com/api/v1) when unset.
# Set it only to point at a sandbox account.
STEADFAST_BASE_URL=
# Shared secret for POST /courier/sync, which Vercel Cron calls on a schedule.
# Unset means the reconciliation endpoint refuses every call; the webhook and
# dispatch still work, but a missed notification is never caught up.
COURIER_SYNC_SECRET=
# Bearer token Steadfast presents when calling POST /courier/webhook.
#
# YOU generate this — it is not issued by Steadfast. Paste the same value into
# their portal under Webhook Integration → "Auth Token (Bearer)", and set the
# Callback Url to <api-origin>/api/v1/courier/webhook.
#
# Register the webhook in their portal LAST, only after this endpoint is
# deployed and answering: registering against a 404 drops real notifications
# with no record they were sent. Unset means the endpoint refuses every call.
STEADFAST_WEBHOOK_TOKEN=
