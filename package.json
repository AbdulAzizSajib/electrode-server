{
  "name": "Gadgets Ecommerce Backend - Node.js, Express, PostgreSQL, Prisma",
  "version": "1.0.0",
  "description": "",
  "main": "dist/app/server.js",
  "scripts": {
    "start": "node dist/app/server.js",
    "start:bun": "bun dist/app/server.js",
    "build": "prisma generate && tsc && node scripts/fix-imports.js",
    "build:local": "tsc && node scripts/fix-imports.js",
    "dev": "tsx watch src/app/server.ts",
    "lint": "eslint ./src/**/*",
    "migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "generate": "prisma generate",
    "studio": "prisma studio",
    "backfill:total-sold": "tsx scripts/backfill-total-sold.mjs",
    "db:latency": "node scripts/db-latency.mjs",
    "db:copy": "node scripts/migrate-region.mjs",
    "push": "prisma db push",
    "pull": "prisma db pull",
    "test": "echo \"Error: no test specified\" && exit 1",
    "verify:postman": "tsx scripts/verify-postman-routes.ts",
    "verify:catalog": "tsx scripts/verify-catalog-change.ts",
    "verify:checkout": "tsx scripts/verify-checkout-totals.ts",
    "verify:settings": "tsx scripts/verify-site-settings.ts",
    "verify:supplier-payments": "tsx scripts/verify-supplier-payments.ts",
    "verify:reports": "tsx scripts/verify-reports.ts",
    "verify:currency": "tsx scripts/verify-currency-and-content.ts",
    "verify:blog": "tsx scripts/verify-blog-and-testimonials.ts",
    "verify:landing-page": "tsx scripts/verify-landing-page.ts",
    "seed:demo-landing-page": "tsx scripts/seed-demo-landing-page.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.20.0",
  "type": "module",
  "dependencies": {
    "@prisma/adapter-pg": "7.3.0",
    "@prisma/client": "7.3.0",
    "better-auth": "^1.4.18",
    "cloudinary": "^2.9.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "ejs": "^4.0.1",
    "express": "^5.2.1",
    "http-status": "^2.1.0",
    "jsonwebtoken": "^9.0.3",
    "ms": "^2.1.3",
    "multer": "^2.0.2",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.1",
    "pg": "^8.18.0",
    "qs": "^6.14.1",
    "uuid": "^13.0.0",
    "vercel": "^56.3.1",
    "zod": "^4.3.6"
