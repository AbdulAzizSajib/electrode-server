model Banner {
  id String @id @default(uuid(7))

  type      BannerType      @default(IMAGE)
  placement BannerPlacement

  // ---- IMAGE type er jonno ----
  /// Required for an IMAGE banner (enforced in banner.validation.ts). Nullable
  /// because a DYNAMIC banner can render over a bgColor with no artwork at all.
  image       String?
  mobileImage String?

  // ---- DYNAMIC type er jonno (type = DYNAMIC hole use hobe) ----
  title       String?
  subtitle    String?
  description String?

  /// Only meaningful when `productId` is null. A product-linked banner always
  /// serves the linked Product's live offerPrice/sellingPrice, so these columns
  /// are ignored for it. Kept for product-less banners (bundles, category-wide
  /// sales) that still need a price to display.
  price         Decimal? @db.Decimal(10, 2)
  discountPrice Decimal? @db.Decimal(10, 2)

  buttonText String? @default("Shop Now")
  bgColor    String? // hex code, e.g. "#FF5733"
  textColor  String?

  // ---- Link / target ----
  link      String? // fallback manual link
  productId String?
  product   Product? @relation(fields: [productId], references: [id])

  // ---- Promo strip membership ----
  /// The promotional strip this banner is a tile of, or null for none.
  ///
  /// A BANNER BELONGS TO AT MOST ONE GROUP. A nullable FK rather than a join
  /// table, because a join table would model a cardinality that is not
  /// permitted and would then need a uniqueness constraint to forbid it again.
  ///
  /// ONLY A `MID` BANNER MAY BE ASSIGNED — enforced in banner.service.ts, not
  /// here, since Postgres cannot express "this column may only be set when that
  /// column holds a particular value". The hero placements are owned by the
  /// Home Slider manager with its own capacity rules (hero-slots.ts); letting a
  /// group claim one would mean the same record edited from two surfaces under
  /// two different sets of rules.
  ///
  /// Null is a REAL state, not "unset": a `MID` banner with no group is on file
  /// and editable in the admin, and renders in no strip. That is what makes
  /// `onDelete: SetNull` on the relation a complete answer to a deleted group.
  promoBannerGroupId String?
  promoBannerGroup   PromoBannerGroup? @relation(fields: [promoBannerGroupId], references: [id], onDelete: SetNull)

  status    BannerStatus @default(DRAFT)
  sortOrder Int          @default(0)

  startsAt DateTime?
  endsAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([placement])
  @@index([placement, sortOrder])
  /// The storefront reads a strip's tiles as "this group, in the merchant's
  /// order", and the admin's group editor reads the same thing.
  @@index([promoBannerGroupId, sortOrder])
}
