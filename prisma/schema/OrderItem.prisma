model OrderItem {
  id String @id @default(cuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  productName String
  sku         String?

  quantity Int

  unitPrice  Decimal @db.Decimal(12, 2)
  totalPrice Decimal @db.Decimal(12, 2)

  /// What the unit sold COST, captured at placement on the same footing as
  /// `unitPrice` above: the variant's cost basis when this line names a variant
  /// that has one, else the product's. Never recalculated, so a purchase receipt
  /// that later moves the cost basis leaves a placed order's margin alone.
  ///
  /// Nullable, and null means the cost was unknown — never zero. Rows placed
  /// before this column existed are not backfilled, because today's cost stamped
  /// on last year's sale is a fabricated margin, and a product that never had a
  /// purchase price recorded genuinely has no cost to capture. Anything deriving
  /// profit from this MUST exclude nulls rather than treat them as free goods.
  ///
  /// Supplier cost: excluded from every customer-facing order projection.
  unitCost Decimal? @db.Decimal(12, 2)

  returnItems ReturnItem[]

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
}
