model PurchaseOrderItem {
  id String @id @default(cuid())

  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  // Optional: a purchase order line may replenish a specific variant.
  // Stock is held per (warehouse, product, variant) and customer orders deduct
  // against the variant actually bought, so a PO for a variable product must be
  // able to say which variant it covers — otherwise the received stock lands on
  // a `variantId: null` row that those orders can never match.
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id])

  quantity Int

  unitCost  Decimal @db.Decimal(12, 2)
  totalCost Decimal @db.Decimal(12, 2)

  receivedQuantity Int @default(0)

  createdAt DateTime @default(now())

  @@index([purchaseOrderId])
  @@index([productId])
  @@index([variantId])
}
