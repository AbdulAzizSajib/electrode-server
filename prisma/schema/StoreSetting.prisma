/// Singleton store-wide configuration row. There must always be exactly
/// one row, keyed by the fixed id "singleton" (upsert on that id - never
/// create a second row). Deliberately single-currency - no multi-currency
/// support, no per-region pricing and no conversion rates (see design.md
/// Non-Goals in openspec/changes/add-cart-wishlist-store-config, and again in
/// openspec/changes/add-currency-format-and-home-content-cms).
///
/// TAX IS NOT CONFIGURED HERE. This row carried a shop-wide
/// `defaultTaxRatePercent` until add-currency-format-and-home-content-cms
/// removed it: TaxRule now owns tax properly - named rules, percent or flat,
/// assigned per product - and a product with no rule is untaxed. Do not add a
/// fallback rate back. Two sources of tax meant a merchant reading their Tax
/// Rules list was not reading every tax their shop charged.
///
/// The Json columns below carry the storefront's header/footer presentation
/// content. Postgres does not constrain their shape, so the Zod schemas in
/// store-setting.validation.ts are the ONLY gate - every write must go
/// through them and no code path may persist an unvalidated value. Reads
/// are correspondingly trusted, and merge over DEFAULT_PUBLIC_SETTINGS so a
/// cleared column still renders a usable header/footer.
model StoreSetting {
  id String @id @default("singleton")

  storeName String @default("Ecom")

  currency       String @default("BDT")
  currencySymbol String @default("৳")

  /// How a monetary amount is written, together with `currencySymbol` above.
  ///
  /// `currencyDecimals` is PRESENTATION ONLY. Money is stored `Decimal(12,2)`
  /// and computed in cents throughout; this governs how many digits are shown
  /// and nothing else. Setting it to 0 rounds the displayed figure, not the
  /// charged one — so displayed line items may not visibly sum to the displayed
  /// total, and the admin panel says so beside the field. Setting it above 2
  /// shows trailing zeros that carry no stored precision.
  ///
  /// Bounded 0–4 in store-setting.validation.ts, which Postgres cannot express:
  /// 0 covers currencies with no minor unit, 3 covers those with three, and 4
  /// is headroom. The defaults reproduce the storefront's pre-configuration
  /// rendering exactly, so the additive migration changes nothing on its own.
  currencyPosition CurrencyPosition @default(BEFORE)
  currencyDecimals Int              @default(2)

  /// Order value above which delivery is free, or null when the shop makes no
  /// such offer. Null and 0 are DIFFERENT: 0 makes every order's delivery free.
  /// Edited on UI → Checkout Setting, not on Store Settings — it is a decision
  /// about what an order costs, which is what that screen owns.
  freeShippingThreshold Decimal? @db.Decimal(12, 2)

  /// Guest COD abuse limits. Guest checkout has neither a session nor a
  /// payment step, so nothing else stops one visitor placing unlimited COD
  /// orders that deduct real stock. Tunable here rather than hardcoded
  /// because the right values only emerge from real order data - start
  /// conservative and loosen. See openspec/changes/add-guest-cod-checkout.
  maxPendingCodOrdersPerPhone Int @default(3)
  maxGuestOrdersPerIpPerHour  Int @default(10)

  contactEmail String?
  contactPhone String?
  address      String?

  /// Branding. `siteNameAccent` is the second, accent-coloured half of the
  /// wordmark (the storefront renders `storeName` + `siteNameAccent`).
  ///
  /// Two logos, not one: storefront headers and footers are commonly
  /// light-on-dark and dark-on-light respectively, so one image cannot serve
  /// both. These columns SUPPLY the artwork; they do not decide whether it is
  /// shown — `headerBrandMode`/`footerBrandMode` below do. Uploading a logo is
  /// therefore never itself a publish action, and a slot showing the wordmark
  /// keeps its artwork on file.
  ///
  /// In logo mode the footer resolves `footerLogoUrl`, falling back to
  /// `logoUrl` when it has none of its own. Null and "a copy of the header's
  /// URL" are deliberately different: clearing the footer's artwork must
  /// restore that fallback rather than pin a copy, which is also why
  /// DEFAULT_PUBLIC_SETTINGS.footerLogoUrl is null and not a copy of logoUrl.
  logoUrl        String?
  footerLogoUrl  String?
  siteNameAccent String?
  aboutText      String?
  copyrightText  String?

  /// Whether each brand slot shows the wordmark or its logo image.
  ///
  /// Set INDEPENDENTLY — header logo above a wordmark footer, or the reverse,
  /// are both ordinary configurations. See the BrandDisplayMode doc-comment for
  /// why this is a stored mode rather than something derived from whether an
  /// image happens to be uploaded.
  ///
  /// Both default to TEXT, and that is the entire backwards-compatibility
  /// story: before these columns the storefront rendered the wordmark
  /// unconditionally in both slots — it never read `logoUrl` at all — so TEXT
  /// reproduces existing behaviour exactly, including for a store that had
  /// already uploaded artwork. The migration is additive with no backfill and
  /// changes no storefront's rendering on deploy.
  ///
  /// A slot in LOGO mode whose fallback chain yields no URL renders the
  /// wordmark. The brand block is on every page of the site, so a blank one is
  /// worse than the text it replaced — see the `storefront-branding` spec, "A
  /// brand slot never renders empty".
  headerBrandMode BrandDisplayMode @default(TEXT)
  footerBrandMode BrandDisplayMode @default(TEXT)

  /// Displayed height of each logo, in pixels. Width always follows the image's
  /// own proportions, so artwork of any aspect ratio renders undistorted and
  /// never needs re-cutting.
  ///
  /// Bounded 24-96 in store-setting.validation.ts, which Postgres cannot
  /// express — so Zod is the ONLY gate, exactly as with `currencyDecimals`. 24
  /// is roughly where a logo stops being legible beside the header's text
  /// controls; 96 is past the header row's natural height, so anything larger
  /// is a layout the row was not built for rather than a bigger logo.
  ///
  /// The storefront reserves this height before the image loads, which is what
  /// keeps a late-arriving logo from shifting the page under a shopper who has
  /// already started reading. That is also why no intrinsic width/height is
  /// stored: reserving the box gets the same guarantee without probing every
  /// upload. See add-header-footer-brand-display design.md, Decisions 2 and 3.
  headerLogoHeight Int @default(40)
  footerLogoHeight Int @default(36)

  /// SEO surface. `siteUrl` is the canonical origin used to resolve absolute
  /// metadata URLs; `metaTitle` falls back to `storeName` when unset, so the
  /// storefront's document title is never empty.
  ///
  /// These three stayed as columns rather than folding into `seoConfig` below:
  /// `siteUrl` already resolves the storefront's `metadataBase`, and moving
  /// them would be a data migration for no user-visible gain. The admin edits
  /// all of them from one screen (SEO → General) either way.
  siteUrl         String?
  metaTitle       String?
  metaDescription String?

  /// Everything else the SEO menu owns, Zod-validated on write exactly like
  /// the blobs below — `seoConfigSchema` in store-setting.validation.ts is the
  /// ONLY gate on its shape.
  ///
  /// seoConfig: { titleTemplate, defaultMetaTitle, defaultMetaDescription,
  ///              defaultOgImageUrl, twitterCardType, twitterSite,
  ///              robots: { globalNoindex, groups: { <routeGroup>: { index, follow } },
  ///                        customRules },
  ///              sitemap: { <contentType>: boolean },
  ///              structuredData: { enableOrganization, enableProduct,
  ///                                enableArticle, enableBreadcrumb,
  ///                                organization: { legalName, logoUrl, email,
  ///                                                phone, sameAs: [url] } },
  ///              verification: { google, bing, other } }
  ///
  ///   `robots.groups` is keyed by a CLOSED set of route groups (see
  ///   SEO_ROUTE_GROUPS in store-setting.constant.ts), not by free-form path
  ///   patterns: a merchant can read a checklist, and a typo in a glob that
  ///   silently deindexes the catalog is not a failure mode worth having.
  ///   `robots.globalNoindex` overrides every per-group setting — it is the
  ///   staging-site kill switch, so nothing may quietly re-enable indexing.
  ///
  /// READ WITH A DEEP PER-KEY MERGE over DEFAULT_SEO_CONFIG (see
  /// mergeSeoConfig), not a wholesale `??` — this blob is nested, and a row
  /// written before a key existed must come back with that key at its default
  /// rather than `undefined`. `undefined` is falsy, and for an `index` flag
  /// that silently withdraws a page from search.
  ///
  /// Nullable with no backfill: null resolves to DEFAULT_SEO_CONFIG, which
  /// reproduces the storefront's pre-configuration metadata exactly, so the
  /// additive migration changes nothing on its own.
  seoConfig Json?

  /// Zod-validated on write - see the model doc-comment above.
  /// mainNav:         [{ label, href, children?: [{ label, href }] }] (one level deep)
  /// footerColumns:   [{ title, links: [{ label, href }] }]
  /// socialLinks:     [{ platform, url }]
  /// announcementBar: { enabled, text, links: [{ icon, label, href }] }
  /// newsletter:      { heading, subtext, placeholder, buttonLabel }
  mainNav         Json?
  footerColumns   Json?
  socialLinks     Json?
  announcementBar Json?
  newsletter      Json?

  /// Zod-validated on write exactly like the presentation columns above - the
  /// schemas in store-setting.validation.ts are the ONLY gate on their shape,
  /// and both carry invariants Postgres cannot express.
  ///
  /// checkoutConfig: { fields: { <fieldKey>: { show, required } }, showCouponBox,
  ///                   showOrderNote, allowGuestCheckout, notice }
  ///   Field keys are the ORDER PAYLOAD's own keys (fullName, phone,
  ///   addressLine1, addressLine2, city, postalCode) so order.service.ts can
  ///   validate by iterating the map rather than by a switch it has to keep in
  ///   step with the admin table. Two invariants are enforced in Zod: no field
  ///   may be hidden-and-required, and `phone` may never be hidden or optional
  ///   (guest order lookup and the per-phone COD cap are both keyed on it).
  ///   order.service.ts re-checks phone independently, so a row edited outside
  ///   the API cannot disable it either.
  ///
  /// theme: { background, foreground, brand, brandDark, accent, sale,
  ///          maxWidth, font: { family, url }, adminFont: { family, url } }
  ///   Colours are strict hex - the values are interpolated into an inline
  ///   style attribute on the storefront's <html>, so a value that could carry
  ///   further declarations is rejected. Both `url`s are REBUILT by the parser
  ///   from validated components and are never a substring of merchant input.
  ///
  ///   `font` is the STOREFRONT's typeface, `adminFont` the ADMIN PANEL's;
  ///   they are chosen independently. Each is a denormalised copy of a row in
  ///   the `Font` library rather than a reference to one, which is why the
  ///   storefront read path joins nothing and why a font cannot be deleted
  ///   while it is selected - see font.service.ts. `adminFont` may be absent
  ///   on a row written before it existed; reads resolve it from DEFAULT_THEME.
  checkoutConfig Json?
  theme          Json?

  /// Which optional catalog features the storefront offers:
  /// { showWishlist, showCompare, showQuickView }, all booleans.
  ///
  /// Zod-validated on write like the blobs above — `catalogConfigSchema` in
  /// store-setting.validation.ts is the ONLY gate on its shape.
  ///
  /// READ WITH A PER-KEY SPREAD over DEFAULT_CATALOG_CONFIG, not the wholesale
  /// `merge()` the other blobs use. `merge()` swaps the entire value for the
  /// fallback, so a row written before a key existed comes back WITHOUT it —
  /// which is exactly the bug that forced the `withDeliveryDefault` shim onto
  /// checkoutConfig when `delivery` was added. This blob is a flat map of
  /// booleans and will gain more, so it is read the right way from the start;
  /// a missing flag then reads at its default instead of `undefined`, which is
  /// falsy and would withdraw the feature by accident.
  ///
  /// Nullable with no backfill: all three default to TRUE, so an existing store
  /// and a fresh install both behave exactly as they did before this column.
  /// Turning one off is a PRESENTATION decision only — the wishlist and compare
  /// APIs stay open, so a merchant who turns a feature off and back on finds
  /// their shoppers' saved lists intact.
  catalogConfig Json?

  /// Whether the storefront root serves the full shop or a single campaign
  /// landing page, and which landing page that is.
  ///
  /// Shop-wide singleton facts, so they live on the singleton row — which also
  /// means the storefront learns the mode from the settings payload it ALREADY
  /// fetches in its root layout on every page. No second request, no second
  /// cache, no second staleness window.
  ///
  /// The two columns are only meaningful together, and their invariants need a
  /// database read, so they are enforced in store-setting.service.ts rather
  /// than in Zod — transactionally, re-reading the counterpart row, so two
  /// admins racing cannot land in mode-on-pointing-at-a-draft:
  ///   - entering LANDING_PAGE requires `activeLandingPageId` to resolve to an
  ///     existing PUBLISHED page;
  ///   - the active page cannot be unpublished or deleted while the mode is on
  ///     (enforced from the landing-page side);
  ///   - the active selection cannot be cleared while the mode is on.
  ///
  /// SetNull, not Restrict: deleting the selected page while in WEBSITE mode is
  /// allowed and simply empties the pointer, which then blocks the next attempt
  /// to switch the mode on. A shop is never left serving a page that is gone.
  siteMode SiteMode @default(WEBSITE)

  activeLandingPageId String?
  activeLandingPage   LandingPage? @relation(fields: [activeLandingPageId], references: [id], onDelete: SetNull)

  /// Which courier the shop dispatches through.
  ///
  /// THE SELECTION LIVES HERE; THE CREDENTIALS DO NOT. This row is served by a
  /// public endpoint, so a secret on it is one careless field selection away
  /// from being published — which is why the Steadfast keys sit in the
  /// environment and stay there. An enum naming a courier grants nothing to
  /// whoever reads it, so it is safe on the same row.
  ///
  /// Defaults to STEADFAST so an installation that predates this column keeps
  /// dispatching exactly as before, with no configuration step. There is no
  /// unset state: a nullable selection would force every dispatch path to
  /// answer "what if nobody chose", and MANUAL already models "we use a courier
  /// this system does not integrate with".
  ///
  /// Changing this is REFUSED while consignments created by the current
  /// provider are still in flight — see store-setting.service.ts. Routing for
  /// an existing consignment reads `Shipment.courierProvider`, never this
  /// field.
  ///
  /// See openspec/changes/add-courier-provider-selection, design.md Decisions 4
  /// and 8.
  courierProvider CourierProvider @default(STEADFAST)

  updatedAt DateTime @updatedAt
}
