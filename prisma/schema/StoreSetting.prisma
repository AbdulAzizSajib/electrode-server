/// Singleton store-wide configuration row. There must always be exactly
/// one row, keyed by the fixed id "singleton" (upsert on that id - never
/// create a second row). Deliberately single-currency - no multi-currency
/// support, no per-region pricing and no conversion rates (see design.md
/// Non-Goals in openspec/changes/add-cart-wishlist-store-config, and again in
/// openspec/changes/add-currency-format-and-home-content-cms).
///
/// TAX IS NOT CONFIGURED HERE. This row carried a shop-wide
/// `defaultTaxRatePercent` until add-currency-format-and-home-content-cms
/// removed it: TaxRule now owns tax properly - named rules, percent or flat,
/// assigned per product - and a product with no rule is untaxed. Do not add a
/// fallback rate back. Two sources of tax meant a merchant reading their Tax
/// Rules list was not reading every tax their shop charged.
///
/// The Json columns below carry the storefront's header/footer presentation
/// content. Postgres does not constrain their shape, so the Zod schemas in
/// store-setting.validation.ts are the ONLY gate - every write must go
/// through them and no code path may persist an unvalidated value. Reads
/// are correspondingly trusted, and merge over DEFAULT_PUBLIC_SETTINGS so a
/// cleared column still renders a usable header/footer.
model StoreSetting {
  id String @id @default("singleton")

  storeName String @default("Ecom")

  currency       String @default("BDT")
  currencySymbol String @default("৳")

  /// How a monetary amount is written, together with `currencySymbol` above.
  ///
  /// `currencyDecimals` is PRESENTATION ONLY. Money is stored `Decimal(12,2)`
  /// and computed in cents throughout; this governs how many digits are shown
  /// and nothing else. Setting it to 0 rounds the displayed figure, not the
  /// charged one — so displayed line items may not visibly sum to the displayed
  /// total, and the admin panel says so beside the field. Setting it above 2
  /// shows trailing zeros that carry no stored precision.
  ///
  /// Bounded 0–4 in store-setting.validation.ts, which Postgres cannot express:
  /// 0 covers currencies with no minor unit, 3 covers those with three, and 4
  /// is headroom. The defaults reproduce the storefront's pre-configuration
  /// rendering exactly, so the additive migration changes nothing on its own.
  currencyPosition CurrencyPosition @default(BEFORE)
  currencyDecimals Int              @default(2)

  /// Order value above which delivery is free, or null when the shop makes no
  /// such offer. Null and 0 are DIFFERENT: 0 makes every order's delivery free.
  /// Edited on UI → Checkout Setting, not on Store Settings — it is a decision
  /// about what an order costs, which is what that screen owns.
  freeShippingThreshold Decimal? @db.Decimal(12, 2)

  /// Guest COD abuse limits. Guest checkout has neither a session nor a
  /// payment step, so nothing else stops one visitor placing unlimited COD
  /// orders that deduct real stock. Tunable here rather than hardcoded
  /// because the right values only emerge from real order data - start
  /// conservative and loosen. See openspec/changes/add-guest-cod-checkout.
  maxPendingCodOrdersPerPhone Int @default(3)
  maxGuestOrdersPerIpPerHour  Int @default(10)

  contactEmail String?
  contactPhone String?
  address      String?

  /// Branding. `siteNameAccent` is the second, accent-coloured half of the
  /// wordmark (the storefront renders `storeName` + `siteNameAccent`).
  ///
  /// Two logos, not one: storefront headers and footers are commonly
  /// light-on-dark and dark-on-light respectively, so one image cannot serve
  /// both. A store with only `logoUrl` set renders it in both places rather
  /// than leaving the footer's brand slot blank.
  logoUrl        String?
  footerLogoUrl  String?
  siteNameAccent String?
  aboutText      String?
  copyrightText  String?

  /// SEO surface. `siteUrl` is the canonical origin used to resolve absolute
  /// metadata URLs; `metaTitle` falls back to `storeName` when unset, so the
  /// storefront's document title is never empty.
  siteUrl         String?
  metaTitle       String?
  metaDescription String?

  /// Zod-validated on write - see the model doc-comment above.
  /// mainNav:         [{ label, href, children?: [{ label, href }] }] (one level deep)
  /// footerColumns:   [{ title, links: [{ label, href }] }]
  /// socialLinks:     [{ platform, url }]
  /// announcementBar: { enabled, text, links: [{ icon, label, href }] }
  /// newsletter:      { heading, subtext, placeholder, buttonLabel }
  mainNav         Json?
  footerColumns   Json?
  socialLinks     Json?
  announcementBar Json?
  newsletter      Json?

  /// Zod-validated on write exactly like the presentation columns above - the
  /// schemas in store-setting.validation.ts are the ONLY gate on their shape,
  /// and both carry invariants Postgres cannot express.
  ///
  /// checkoutConfig: { fields: { <fieldKey>: { show, required } }, showCouponBox,
  ///                   showOrderNote, allowGuestCheckout, notice }
  ///   Field keys are the ORDER PAYLOAD's own keys (fullName, phone,
  ///   addressLine1, addressLine2, city, postalCode) so order.service.ts can
  ///   validate by iterating the map rather than by a switch it has to keep in
  ///   step with the admin table. Two invariants are enforced in Zod: no field
  ///   may be hidden-and-required, and `phone` may never be hidden or optional
  ///   (guest order lookup and the per-phone COD cap are both keyed on it).
  ///   order.service.ts re-checks phone independently, so a row edited outside
  ///   the API cannot disable it either.
  ///
  /// theme: { background, foreground, brand, brandDark, accent, sale,
  ///          maxWidth, font: { family, url } }
  ///   Colours are strict hex - the values are interpolated into an inline
  ///   style attribute on the storefront's <html>, so a value that could carry
  ///   further declarations is rejected. `font.url` is REBUILT by the parser
  ///   from validated components and is never a substring of merchant input.
  checkoutConfig Json?
  theme          Json?

  /// Whether the storefront root serves the full shop or a single campaign
  /// landing page, and which landing page that is.
  ///
  /// Shop-wide singleton facts, so they live on the singleton row — which also
  /// means the storefront learns the mode from the settings payload it ALREADY
  /// fetches in its root layout on every page. No second request, no second
  /// cache, no second staleness window.
  ///
  /// The two columns are only meaningful together, and their invariants need a
  /// database read, so they are enforced in store-setting.service.ts rather
  /// than in Zod — transactionally, re-reading the counterpart row, so two
  /// admins racing cannot land in mode-on-pointing-at-a-draft:
  ///   - entering LANDING_PAGE requires `activeLandingPageId` to resolve to an
  ///     existing PUBLISHED page;
  ///   - the active page cannot be unpublished or deleted while the mode is on
  ///     (enforced from the landing-page side);
  ///   - the active selection cannot be cleared while the mode is on.
  ///
  /// SetNull, not Restrict: deleting the selected page while in WEBSITE mode is
  /// allowed and simply empties the pointer, which then blocks the next attempt
  /// to switch the mode on. A shop is never left serving a page that is gone.
  siteMode SiteMode @default(WEBSITE)

  activeLandingPageId String?
  activeLandingPage   LandingPage? @relation(fields: [activeLandingPageId], references: [id], onDelete: SetNull)

  updatedAt DateTime @updatedAt
}
