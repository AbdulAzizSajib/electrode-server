model Supplier {
  id String @id @default(uuid(7))

  name        String
  companyName String?

  email String?
  phone String?

  address String?
  city    String?
  country String  @default("Bangladesh")

  isActive Boolean @default(true)

  purchases PurchaseOrder[]

  payments SupplierPayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
