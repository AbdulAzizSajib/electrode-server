model Brand {
  id String @id @default(uuid(7))

  name        String @db.VarChar(255)
  slug        String  @unique
  description String? @db.Text
  logo        String? @db.VarChar(512)

  status Boolean @default(true)

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}
