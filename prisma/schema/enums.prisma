//  29-8-2026 

/// Which region of the storefront a banner renders in. The three HERO_* values
/// address the homepage hero's visually distinct slots, which have different
/// aspect ratios and so cannot share one bucket:
///   HERO_SLIDER - the large left carousel (multiple banners rotate as slides)
///   HERO_SIDE   - the square tiles at the top right
///   HERO_PROMO  - the wide tile beneath them
/// Kept in sync by hand with `bannerPlacementEnum` in banner.validation.ts.
/// Addressable storefront slot a Campaign can occupy, so the storefront can ask
/// "which campaign is in this slot?" without hardcoding a campaign id. Mirrors
/// how BannerPlacement below addresses hero regions.
///
/// FLASH_SALE is defined but rendered by no storefront section yet — it exists
/// so adding the second slot does not require another migration.
enum CampaignPlacement {
  DEAL_OF_WEEK
  FLASH_SALE
}

enum BannerPlacement {
  HEADER
  MID
  FOOTER
  SIDEBAR
  POPUP
  HERO_SLIDER
  HERO_SIDE
  HERO_PROMO
}

enum BannerType {
  IMAGE // full png/jpg, just clickable, no dynamic content
  DYNAMIC // title, price, discount, button etc dynamically shown on top of bg
}
