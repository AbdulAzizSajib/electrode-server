model Product {
  id String @id @default(cuid())

  name String
  slug String @unique

  sku String? @unique

  description      String?
  shortDescription String?

  type   ProductType   @default(SIMPLE)
  status ProductStatus @default(DRAFT)

  /// Primary/canonical category (used for the product's URL/breadcrumb).
  /// For supplementary categorization (a product listed under more than
  /// one category page), see `categories` (ProductCategory) below -
  /// additive, does not replace this field.
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  brandId String?
  brand   Brand?  @relation(fields: [brandId], references: [id], onDelete: SetNull)

  /// How this product is taxed. Nullable in the schema only because existing
  /// rows predate it; every product is backfilled to the default rule by the
  /// migration, and the service requires one on write. Restrict, not SetNull:
  /// a product with no tax rule cannot be taxed, so a rule in use must be
  /// reassigned before it can be deleted.
  taxRuleId String?
  taxRule   TaxRule? @relation(fields: [taxRuleId], references: [id], onDelete: Restrict)

  /// There is deliberately no delivery field here. Delivery is a store-wide
  /// list of named options the shopper picks from at checkout, held in
  /// StoreSetting.checkoutConfig — not a property of a product. See
  /// openspec/changes/replace-shipping-rules-with-delivery-options.

  /// An optional "buy N get M free" offer. Genuinely optional — most products
  /// carry none — so SetNull: deleting the deal leaves its products sold
  /// without an offer rather than blocking the delete.
  bundleDealId String?
  bundleDeal   BundleDeal? @relation(fields: [bundleDealId], references: [id], onDelete: SetNull)

  /// The three prices, named for what a merchant means by them.
  ///
  /// `offerPrice` is what the shopper is charged and is the only one required —
  /// a product must have a price to be sold. `sellingPrice` is the regular
  /// price, rendered struck through above the offer price, and is null when no
  /// offer is running. `purchasePrice` is supplier cost: admin-only, excluded
  /// from every public projection and from the public sort allowlist.
  ///
  /// `purchasePrice` is a COST BASIS, not a figure fixed when the product was
  /// created: it means "what the stock currently on hand cost to acquire". A
  /// merchant may author it, which sets the opening cost for an item never
  /// bought through a purchase order — but from the first goods receipt onward
  /// `receivePurchaseOrder` maintains it as a moving weighted average over
  /// landed cost, and an authored value it overwrites is not preserved anywhere.
  ///
  /// The flow is one-way: a receipt writes this, and this never writes back into
  /// a purchase order. `PurchaseOrderItem.unitCost` stays the immutable record of
  /// what a supplier actually charged. See purchase-order.cost.ts.
  offerPrice    Decimal  @db.Decimal(12, 2)
  sellingPrice  Decimal? @db.Decimal(12, 2)
  purchasePrice Decimal? @db.Decimal(12, 2)

  stockQuantity     Int @default(0)
  lowStockThreshold Int @default(5)

  weight Decimal? @db.Decimal(10, 3)

  /// What the product is sold in — "1 kg", "500 ml", "pack of 12". Free text
  /// because units are not enumerable across a general catalogue.
  unit String?

  /// A short storefront label — "New", "Hot". Presentation only; it grants no
  /// behaviour and is not a status.
  badge String?

  /// Facts a shopper needs before buying. Null means the merchant has not said,
  /// which the storefront shows as nothing rather than as "No" — an unanswered
  /// question and a negative answer are different claims.
  isRefundable Boolean?
  hasWarranty  Boolean?

  /// An optional product video and its poster frame, uploaded together and
  /// shown alongside the gallery.
  video          String?
  videoThumbnail String?

  isFeatured Boolean @default(false)

  /// Denormalized aggregate of this product's APPROVED reviews, maintained by
  /// ReviewService.recalculateProductRating on every moderation event. Stored
  /// rather than computed because Prisma cannot orderBy a relation aggregate,
  /// so "sort by rating" would otherwise be impossible. A product with no
  /// approved reviews reads 0/0 - never null.
  averageRating Decimal @default(0) @db.Decimal(3, 2)
  reviewCount   Int     @default(0)

  /// Denormalized lifetime units sold, maintained by PaymentService on payment
  /// state transitions. Stored for the same reason as averageRating above:
  /// Prisma cannot orderBy a relation aggregate, so "sort by best selling"
  /// (a sum over OrderItem.quantity) would otherwise be impossible.
  ///
  /// Counts only sales whose payment reached PAID — never order placement.
  /// Guest checkout is COD and creates its Payment as PENDING at placement
  /// (order.service.ts), so counting at placement would credit every
  /// uncollected parcel as a sale. Decremented when a PAID payment is later
  /// refunded or cancelled, floored at 0.
  totalSold Int @default(0)

  /// Denormalized lifetime product-page views, maintained by ProductViewService
  /// on each counted view. Stored for the same reason as totalSold above:
  /// Prisma cannot orderBy a relation aggregate, so "sort by most viewed" over
  /// ProductView rows would otherwise be impossible.
  ///
  /// A LIFETIME TOTAL — it says nothing about the present moment. It is not a
  /// count of people currently on the page, and no code may present it as one.
  /// Deduplicated per viewer per product per window before it is incremented,
  /// so it means "how many people looked", not "how many requests arrived".
  viewCount Int @default(0)

  /// Dedup ledger for viewCount above. Never read to answer "how many viewers
  /// now" — see ProductView.
  views ProductView[]

  seoTitle       String?
  seoDescription String?

  images     ProductImage[]
  variants   ProductVariant[]
  attributes ProductAttribute[]

  orderItems OrderItem[]
  reviews    Review[]

  stockMovements StockMovement[]
  stocks         Stock[]

  campaignProducts   CampaignProduct[]
  couponProducts     CouponProduct[]
  purchaseOrderItems PurchaseOrderItem[]

  cartItems     CartItem[]
  wishlistItems WishlistItem[]

  /// Supplementary categories beyond `category` above (many-to-many via
  /// ProductCategory). A product with an empty list here is still fully
  /// discoverable via its primary `category`.
  categories ProductCategory[]

  /// Merchandising groupings, independent of `category` above.
  collections ProductCollection[]

  /// Keywords, shared across the shop so they can be suggested rather than
  /// retyped.
  tags ProductTag[]

  //banner relation
  banners Banner[]

  /// Campaign landing pages selling this product. Restrict on the other side:
  /// a product a campaign is still selling cannot be deleted out from under it
  /// (see LandingPage.prisma).
  landingPages LandingPage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([brandId])
  @@index([status])
  @@index([isFeatured])
  @@index([createdAt])
  @@index([averageRating])
  @@index([totalSold])
  @@index([viewCount])
}
