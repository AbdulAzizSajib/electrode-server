model ProductVariant {
  id String @id @default(cuid())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// Display label — "Q86 Retro / White". Once a product defines options this
  /// is no longer what the variant *is*: `optionValues` below is the source of
  /// truth, and this is kept for the admin list, the cart line and order
  /// history, which want one readable string.
  name String

  sku String @unique

  price          Decimal? @db.Decimal(12, 2)
  compareAtPrice Decimal? @db.Decimal(12, 2)
  costPrice      Decimal? @db.Decimal(12, 2)

  stockQuantity Int @default(0)

  attributes Json?

  /// Derived, not authored: set to the url of this variant's lowest-sortOrder
  /// linked image whenever the variant has any, so `cart.service.ts` and
  /// `wishlist.service.ts` — which read this field and were not moved to the
  /// `images` relation — never disagree with what the product page shows.
  /// A value supplied directly is still honored for a variant with no linked
  /// images, so existing clients keep working.
  /// See link-product-images-to-variants design.md Decision 7.
  image String?

  status Boolean @default(true)

  /// Images depicting this variant. An image with no variant is shared across
  /// the whole product rather than belonging here — see ProductImage.variantId.
  images ProductImage[]

  /// The option values that define this variant — exactly one per option of its
  /// product. Empty for a simple product, and for variants authored before
  /// options existed, whose `name` remains the only thing distinguishing them.
  optionValues ProductVariantOptionValue[]

  orderItems         OrderItem[]
  stockMovements     StockMovement[]
  stocks             Stock[]
  cartItems          CartItem[]
  purchaseOrderItems PurchaseOrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([status])
}
